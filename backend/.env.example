PORT=4000
GEMINI_API_KEY=MY_GEMINI_API_KEY

# MongoDB connection URI for investigation persistence.
# Leave empty to fall back to in-memory storage.
MONGODB_URI=mongodb://localhost:27017/chaintrace

# Keep demo mode enabled when provider credentials are unavailable.
DEMO_MODE=true
AUTH_REQUIRED=false
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Required for Ethereum live mode.
ETHERSCAN_API_KEY=RAVH3CSGFMQ5KHQF8X2QUJD8EH7ZQSP69D
ETHERSCAN_API_URL=https://api.etherscan.io/v2/api

# Bitcoin live mode uses the Blockstream API by default.
BITCOIN_API_URL=https://blockstream.info/api

# Abort provider requests after this many milliseconds.
BLOCKCHAIN_PROVIDER_TIMEOUT=10000

# Bounded multi-hop tracing limits.
MAX_HOPS=6
MAX_WALLETS_PER_INVESTIGATION=50
MAX_TRANSACTIONS_PER_WALLET=100
MAX_TOTAL_TRANSACTIONS=500
