PORT=4000

MONGODB_URI=mongodb://localhost:27017/chaintrace

DEMO_MODE=false
AUTH_REQUIRED=true

JWT_SECRET=replace_with_a_long_random_secret

SANCTIONS_ENABLED=false
SANCTIONS_PROVIDER=none
SANCTIONS_API_URL=
SANCTIONS_API_KEY=

ETHERSCAN_API_KEY=your_etherscan_api_key
ETHERSCAN_API_URL=https://api.etherscan.io/v2/api

BITCOIN_API_URL=https://blockstream.info/api

BLOCKCHAIN_PROVIDER_TIMEOUT=30000
BLOCKCHAIN_PROVIDER_MAX_RETRIES=3
BLOCKCHAIN_PROVIDER_RETRY_BASE_DELAY=250
BLOCKCHAIN_PROVIDER_RETRY_MAX_DELAY=5000

MAX_HOPS=3
MAX_WALLETS_PER_INVESTIGATION=25
MAX_TRANSACTIONS_PER_WALLET=50
MAX_TOTAL_TRANSACTIONS=250

INCLUDE_UNCONFIRMED_TRANSACTIONS=false

INVESTIGATION_MAX_RETRIES=3
INVESTIGATION_STALE_TIMEOUT_MS=900000

NEO4J_ENABLED=false
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=your-username
NEO4J_PASSWORD=your-password
NEO4J_DATABASE=neo4j
